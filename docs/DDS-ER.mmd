    SAT_PRODUCT_STATIC{
        hk_product_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от category, brand"
        name varchar(100)
        category varchar(50)
        brand varchar(50)
    }

    SAT_PRODUCT_DYNAMIC{
        hk_product_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от purchase_price, status"
        purchase_price decimal(10,2)
        status boolean
    }

    SAT_STORE{
        hk_store_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от address, region, phone"
        address varchar(100)
        region varchar(50)
        phone varchar(11)
        type varchar(30)
    }
    
    SAT_TRANSACTION{
        hk_transaction_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от date_time, sum_amount, payment_method"
        transaction_date timestamp
        sum_amount decimal(10,2)
        payment_method varchar(10)
    }

    SAT_CLIENT{
        hk_client_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от full_name, phone, email"
        full_name varchar(255)
        birth_date date
        phone varchar(20)
        email varchar(255)
        registratrion_date date
    }

    SAT_CARD{
        hk_card_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от card_number, status"
        card_number varchar(50)
        issue_date date
        status varchar(20)
    }

    SAT_LOYALTY_TXN{
        hk_loyalty_transaction_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от points, transaction_date"
        points integer
        transaction_date timestamp
        type varchar(20)
    }

    SAT_EMPLOYEE{
        hk_employee_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от full_name, position"
        full_name varchar(255)
        position varchar(100)
        ohire_date date
        termination_date date
    }

    SAT_SALE{
        hk_sale_id string PK
        source varchar(50) "Источник"
        load_dts timestamp "Дата и время загрузки"
        load_end_dts timestamp "Дата и время окончания актуальности"
        hash_diff varchar(32) "hash от amount, quantity"
        amount decimal(10,2)
        quantity decimal(10,3)
    }

